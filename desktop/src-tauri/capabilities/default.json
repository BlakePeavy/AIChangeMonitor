{
  "identifier": "default",
  "description": "Main window: sidecar spawn, native folder dialog, remote IPC to the Go UI",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-message",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/aichange",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/aichange",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
